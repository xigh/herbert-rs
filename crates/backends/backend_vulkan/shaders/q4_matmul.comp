#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 32
#endif

// Q4 per-group matrix-matrix multiply (prefill: M>1)
//
// Symmetric signed 4-bit weights, 2 nibbles per byte, group_size=32.
// Per-group f32 scales.
//
// A: float[M*K], W_packed: uint8[N * K/2] (as uint32[N * K/8]),
// scales: float[N * n_groups], C: float[M*N]
// where n_groups = ceil(K / 32)
//
// Dequant: nibble in [0,15], value = (float(nibble) - 8.0) * scale
//
// Push constants: M (u32) + N (u32) + K (u32) = 12 bytes.
// Dispatch: (N, M, 1) workgroups of (SUBGROUP_SIZE, 1, 1) threads.
// Each workgroup handles one (m, n) output element.

layout(local_size_x = SUBGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer ABuf { float A[]; };
layout(set = 0, binding = 1) readonly buffer WBuf { uint W_packed[]; };
layout(set = 0, binding = 2) readonly buffer ScalesBuf { float scales[]; };
layout(set = 0, binding = 3) writeonly buffer CBuf { float C[]; };

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
};

void main() {
    uint n = gl_WorkGroupID.x;
    uint m = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    if (m >= M || n >= N) return;

    float acc = 0.0;
    uint a_base = m * K;
    uint K8 = K >> 3;
    uint n_groups = (K + 31) >> 5;
    uint w_base = n * K8;
    uint s_base = n * n_groups;

    for (uint i = lane; i < K8; i += SUBGROUP_SIZE) {
        uint k = i << 3;
        uint packed = W_packed[w_base + i];

        for (uint nib = 0; nib < 8; nib++) {
            uint k_idx = k + nib;
            if (k_idx >= K) break;
            uint nibble = (packed >> (nib * 4)) & 0xFu;
            float dq = (float(nibble) - 8.0) * scales[s_base + (k_idx >> 5)];
            acc += A[a_base + k_idx] * dq;
        }
    }

    acc = subgroupAdd(acc);

    if (lane == 0) {
        C[m * N + n] = acc;
    }
}
