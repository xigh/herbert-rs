#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 32
#endif

// BF16 matrix-matrix multiply (prefill: M>1)
//
// BF16 weights stored as uint16 pairs packed in uint32.
// No scales (BF16 is a direct floating-point representation).
//
// A: float[M*K], W_packed: uint[N * K/2], C: float[M*N]
// C[m,n] = sum_k(A[m*K + k] * bf16_to_f32(W[n,k]))
//
// Push constants: M (u32), K (u32) = 8 bytes.
// Dispatch: (N, M, 1) workgroups of (SUBGROUP_SIZE, 1, 1) threads.
// Each workgroup handles one (m, n) output element.

layout(local_size_x = SUBGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer ABuf { float A[]; };
layout(set = 0, binding = 1) readonly buffer WBuf { uint W_packed[]; };
layout(set = 0, binding = 2) writeonly buffer CBuf { float C[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
};

void main() {
    uint n = gl_WorkGroupID.x;
    uint m = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    uint N = gl_NumWorkGroups.x;

    if (m >= M) return;

    float acc = 0.0;
    uint a_base = m * K;
    uint K2 = K >> 1;
    uint w_base = n * K2;

    for (uint i = lane; i < K2; i += SUBGROUP_SIZE) {
        uint k = i << 1;
        uint packed = W_packed[w_base + i];

        float w0 = uintBitsToFloat((packed & 0xFFFFu) << 16);
        float w1 = uintBitsToFloat(packed & 0xFFFF0000u);

        acc += A[a_base + k]     * w0;
        acc += A[a_base + k + 1] * w1;
    }

    acc = subgroupAdd(acc);

    if (lane == 0) {
        C[m * N + n] = acc;
    }
}
