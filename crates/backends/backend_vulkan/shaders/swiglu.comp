#version 450

// SwiGLU activation: gate = silu(gate) * up
//
// gate: float[n] (in-place), up: float[n]
// Dispatch: (ceil(n / 256), 1, 1) workgroups of (256, 1, 1) threads.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer GateBuf { float gate[]; };
layout(set = 0, binding = 1) readonly buffer UpBuf { float up[]; };

layout(push_constant) uniform Params {
    uint n;
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n) return;
    float x = gate[tid];
    float silu_x = x / (1.0 + exp(-x));
    gate[tid] = silu_x * up[tid];
}
