#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 32
#endif

// Q4 v5 per-group matrix-vector multiply (decode: M=1)
//
// Vectorized K-group loads: 4 packed words + 1 scale per iteration.
// Processes 32 nibbles (1 full K-group) per loop iteration vs 8 in v0.
// Only 1 scale fetch per iteration instead of potentially 4.
//
// x: float[K], w_packed: uint32[N * K/8], scales: float[N * n_groups], y: float[N]
// K must be a multiple of 32 (always true for Qwen3).
//
// Push constants: N (u32) + K (u32) = 8 bytes.
// Dispatch: (N, 1, 1) workgroups of (SUBGROUP_SIZE, 1, 1) threads.

layout(local_size_x = SUBGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer XBuf { float x[]; };
layout(set = 0, binding = 1) readonly buffer WBuf { uint w_packed[]; };
layout(set = 0, binding = 2) readonly buffer ScalesBuf { float scales[]; };
layout(set = 0, binding = 3) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Params {
    uint N;
    uint K;
};

void main() {
    uint n = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;

    if (n >= N) return;

    float acc = 0.0;
    uint n_groups = K >> 5;       // K / 32
    uint K8 = K >> 3;             // K / 8
    uint w_base = n * K8;
    uint s_base = n * n_groups;

    // Iterate per K-group: 32 elements = 4 packed words
    for (uint g = lane; g < n_groups; g += SUBGROUP_SIZE) {
        float scale = scales[s_base + g];
        uint k_base = g << 5;            // g * 32
        uint w_off = w_base + (g << 2);  // w_base + g * 4

        uint p0 = w_packed[w_off + 0];
        uint p1 = w_packed[w_off + 1];
        uint p2 = w_packed[w_off + 2];
        uint p3 = w_packed[w_off + 3];

        // Process 32 nibbles: 8 per packed word
        for (uint nib = 0; nib < 8; nib++) {
            uint shift = nib << 2;
            acc += x[k_base + nib]      * (float((p0 >> shift) & 0xFu) - 8.0) * scale;
            acc += x[k_base + 8 + nib]  * (float((p1 >> shift) & 0xFu) - 8.0) * scale;
            acc += x[k_base + 16 + nib] * (float((p2 >> shift) & 0xFu) - 8.0) * scale;
            acc += x[k_base + 24 + nib] * (float((p3 >> shift) & 0xFu) - 8.0) * scale;
        }
    }

    acc = subgroupAdd(acc);

    if (lane == 0) {
        y[n] = acc;
    }
}
