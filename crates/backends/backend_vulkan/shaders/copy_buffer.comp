#version 450

// Copy float buffer
// Dispatch: (ceil(n / 256), 1, 1) workgroups of (256, 1, 1) threads.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcBuf { float src[]; };
layout(set = 0, binding = 1) writeonly buffer DstBuf { float dst[]; };

layout(push_constant) uniform Params {
    uint n;
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n) return;
    dst[tid] = src[tid];
}
